<Window x:Class="Chapter03.DockPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chapter03"
        mc:Ignorable="d"
        Title="DockPanel" Height="450" Width="800">
    <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Top" Height="20">Top</Button>
        <Button DockPanel.Dock="Bottom" Height="20">Buttom</Button>
        <Button DockPanel.Dock="Left" Width="20">Left</Button>
        <Button DockPanel.Dock="Right" Width="20">Right</Button>
        <Button>Middle</Button>
    </DockPanel>
</Window>
